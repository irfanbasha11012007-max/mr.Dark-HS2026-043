# Ingestion Configuration
INGEST_CHUNK_SIZE=500
INGEST_CHUNK_OVERLAP=50
INGEST_MIN_CHUNK_LENGTH=20
INGEST_CLEAN_WHITESPACE=true
INGEST_EXTRACT_HEADERS=true

# Supported File Extensions (comma-separated)
INGEST_SUPPORTED_EXTENSIONS=.txt,.md,.markdown,.pdf

# Default Paths
INGEST_INPUT_DIR=data/raw
INGEST_OUTPUT_FILE=data/processed/chunks.jsonl
EVAL_QUESTIONS_FILE=evaluation/eval_questions.jsonl

# Logging
LOG_LEVEL=INFO
